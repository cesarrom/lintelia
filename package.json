{
  "name": "lintelia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "db:start": "bun run --cwd apps/core db:start",
    "db:setup": "bun run --cwd apps/core db:setup",
    "db:seed": "bun run --cwd apps/core db:seed",
    "db:reset": "bun run --cwd apps/core db:reset",
    "restate:serve": "bun run --cwd apps/core restate:serve",
    "restate:register": "bun run --cwd apps/core restate:register",
    "e2e": "bun scripts/e2e.ts",
    "e2e:watch": "bun scripts/e2e.ts --headed",
    "e2e:headless": "bun scripts/e2e.ts --headless",
    "e2e:status": "bun run --cwd apps/e2e flow-status",
    "redis:start": "bun run --cwd apps/core redis:start",
    "demo:site": "bun run --cwd apps/core demo:site",
    "stack": "bun scripts/stack.ts up",
    "stack:status": "bun scripts/stack.ts status",
    "stack:logs": "bun scripts/stack.ts logs",
    "stack:restart": "bun scripts/stack.ts restart",
    "stack:stop": "bun scripts/stack.ts stop",
    "stack:reset": "bun scripts/stack.ts reset",
    "stack:doctor": "bun scripts/stack.ts doctor",
    "stack:test": "bun scripts/e2e.ts",
    "totp": "bun run --cwd apps/core totp",
    "demo:workflows": "bun run --cwd apps/core demo:workflows",
    "demo:case": "bun run --cwd apps/core demo:case",
    "demo:token": "bun run --cwd apps/core demo:token",
    "connectors:register": "bun run --cwd apps/core connectors:register",
    "db:migrate": "bun run --cwd apps/core db:migrate",
    "demo:files": "bun run --cwd apps/core demo:files",
    "demo:auto-finance": "bun run --cwd apps/core demo:auto-finance"
  },
  "devDependencies": {
    "@restatedev/restate": "1.7.12",
    "@restatedev/restate-server": "1.8.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*",
    "fake-services/*"
  ],
  "trustedDependencies": [
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64"
  ]
}
