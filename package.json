{
  "name": "fintivio-sst",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "set-env": "export AWS_ACCESS_KEY= && export AWS_SECRET_ACCESS_KEY= && export AWS_PROFILE=fintivio && export AWS_REGION=us-east-1",
    "build": "pnpm run set-env && sst build",
    "unlock": "pnpm run set-env && sst unlock",
    "console": "pnpm run set-env && sst console",
    "deploy": "pnpm run set-env && sst deploy",
    "refresh": "pnpm run set-env && sst refresh",
    "dev": "pnpm run set-env && sst dev",
    "remove": "pnpm run set-env && sst remove",
    "domain:start": "ngrok http --domain=normal-spider-genuine.ngrok-free.app",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.4",
    "@types/aws-lambda": "8.10.143",
    "aws-cdk-lib": "2.142.1",
    "constructs": "10.3.0",
    "sst": "3.0.66",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@types/node": "^22.5.0",
    "sst": "3.0.68"
  }
}
