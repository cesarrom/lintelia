{
  "name": "@fintivio/client-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Put your Fintivio client app in your own site or mobile app: embedded (iframe / WebView) or headless API client, with React and React Native bindings (docs/plans/11).",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./react-native": "./src/react-native.tsx",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "test": "bun test",
    "check-types": "tsc --noEmit -p .",
    "build:browser": "bun build ./src/browser.ts --outfile dist/fintivio-client.js --minify"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-native-webview": { "optional": true }
  },
  "devDependencies": {
    "jsdom": "^20.0.3"
  }
}
