# Copy to apps/core/.env. Local values only; never commit real credentials.
NODE_ENV=local
PORT=8000
# Public URL of this API (Restate calls ${HOST}/restate)
HOST=http://localhost:8000
# Web app. Tenants are served on <tenant>.${BASE_DOMAIN} (e.g. http://demo-bank.localhost:3001)
WEB_URL=http://localhost:3001
BASE_DOMAIN=localhost:3001
# Extra allowed browser origins (comma-separated). WEB_URL, <tenant>.BASE_DOMAIN and tenant custom domains are
# always allowed.
CORS_ORIGINS=

# --- Database: one Postgres (embedded for local dev, see `bun run db:start`) ---
# Owner/superuser: used only by scripts/db.ts for migrations. The API never connects with it.
DATABASE_OWNER_URL=postgres://postgres:postgres@localhost:5433/fintivio
# Restricted roles the API uses (row level security applies). Passwords are set by `db:start` from these URLs.
DATABASE_URL=postgres://fintivio_app:fintivio_app_local@localhost:5433/fintivio
DATABASE_PLATFORM_URL=postgres://fintivio_platform:fintivio_platform_local@localhost:5433/fintivio
EMBEDDED_PG_DIR=.data/postgres
# Password for the seeded development accounts (default: fintivio-dev-password)
# SEED_PASSWORD=

# --- Redis (sessions, one-time codes, rate limits; `bun run redis:start`) ---
REDIS_URL=redis://localhost:6380

# --- Auth (local provider) ---
# At least 32 characters. Generate one: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_JWT_SECRET=
# Access tokens are short-lived; sessions continue with rotating refresh tokens (stored in Redis)
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=43200

# --- Restate (see RESTATE.md) ---
RESTATE_ENDPOINT=http://localhost:8080
RESTATE_ADMIN_ENDPOINT=http://localhost:9070
RESTATE_AUTO_REGISTER=true
# Request signing keys (publickeyv1_...), required outside local development
# RESTATE_IDENTITY_KEYS=

# --- E-mail: "smtp" sends through SMTP_* (locally: the mailbox fake, web inbox on http://localhost:8025);
# "outbox" writes JSON files to EMAIL_OUTBOX_DIR instead ---
EMAIL_PROVIDER=smtp
EMAIL_OUTBOX_DIR=.data/outbox
EMAIL_FROM=Fintivio <no-reply@fintivio.local>
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/files

# --- Vendors without a local fake yet (features report "not configured" when unset) ---
# OPENAI_API_KEY=

# --- Outbound webhooks: seconds between attempts (short locally so retries are visible), disable after failing ---
WEBHOOK_RETRY_SCHEDULE=2,4,8,30,120,600
# WEBHOOK_DISABLE_AFTER_SECONDS=86400
# WEBHOOK_ALLOW_PRIVATE_URLS=true
