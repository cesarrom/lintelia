{
  "name": "core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "test": "bun test",
    "build": "echo 1",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "bun --watch ./src/main.ts",
    "start": "NODE_ENV=production bun ./src/main.ts",
    "db:start": "bun ./scripts/db.ts start",
    "db:setup": "bun ./scripts/db.ts setup",
    "db:migrate": "bun ./scripts/db.ts migrate",
    "db:seed": "bun ./scripts/db.ts seed",
    "db:reset": "bun ./scripts/db.ts reset",
    "db:generate": "drizzle-kit generate",
    "restate:serve": "bun ./scripts/restate.ts serve",
    "restate:register": "bun ./scripts/restate.ts register",
    "redis:start": "bun ./scripts/redis.ts start",
    "demo:site": "bun ./scripts/demo-site.ts",
    "totp": "bun ./scripts/totp.ts",
    "demo:workflows": "bun ./scripts/demo.ts workflows",
    "demo:case": "bun ./scripts/demo.ts case",
    "demo:token": "bun ./scripts/demo.ts token",
    "connectors:databases": "bun ./scripts/connectors.ts databases",
    "connectors:register": "bun ./scripts/connectors.ts register",
    "demo:files": "bun ./scripts/demo.ts files",
    "demo:auto-finance": "bun ./scripts/demo-auto-finance.ts",
    "live:load": "bun ./scripts/live-load.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.9",
    "@nestjs/core": "^10.4.9",
    "@repo/lintelia": "*",
    "@restatedev/restate-sdk": "1.17.2",
    "@restatedev/restate-sdk-clients": "1.17.2",
    "@workos-inc/node": "11.0.0",
    "ajv": "^8.17.1",
    "cheerio": "^1.0.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "env-var": "^7.5.0",
    "file-type": "^20.4.1",
    "hono": "^4.7.8",
    "image-resize-compress": "^2.1.1",
    "jose": "^6.0.0",
    "jsonata": "^2.2.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mustache": "^4.2.0",
    "nodemailer": "^6.9.15",
    "openai": "^4.81.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@restatedev/restate": "1.7.12",
    "@restatedev/restate-server": "1.8.1",
    "@types/bun": "^1.2.12",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash": "^4.17.7",
    "@types/mustache": "^4.2.5",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.25.0",
    "qrcode-generator": "2.0.4",
    "typescript": "5.8.2"
  }
}
