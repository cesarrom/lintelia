# Copy to apps/web/.env
# API (apps/core)
VITE_FILES_API_BASE_URL=http://localhost:8000
# Restate ingress (the web app invokes workflow handlers through it)
VITE_RESTATE_ENDPOINT=http://localhost:8080
# Hosts that serve the platform (staff) app instead of a tenant. Tenants use <tenant>.localhost:3001 locally.
VITE_ROOT_HOSTS=localhost:3001,127.0.0.1:3001
